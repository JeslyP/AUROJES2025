{
  "name": "AURO 2025 Coursework",
  "image": "ghcr.io/uoy-robostar/ros2-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
    "6080": {
      "label": "Desktop"
    }
  },
  "forwardPorts": [
    6080
  ],
  "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh",
  "postCreateCommand": "source /opt/ros/humble/setup.bash",
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}"
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x720x24"
  },
  "customizations": {
    "auro": {
      "scenarios": [
        {
          "name": "Scenario 1 - Single Robot Basic",
          "description": "Single robot, no noise, standard barrel distribution. Tests basic functionality.",
          "parameters": {
            "num_robots": 1,
            "sensor_noise": "false",
            "use_rviz": "true"
          }
        },
        {
          "name": "Scenario 2 - Single Robot with Noise",
          "description": "Single robot with sensor noise enabled. Tests robustness to sensor uncertainty.",
          "parameters": {
            "num_robots": 1,
            "sensor_noise": "true",
            "use_rviz": "true"
          }
        },
        {
          "name": "Scenario 3 - High Contamination",
          "description": "Single robot, mostly red barrels. Tests decontamination strategy.",
          "parameters": {
            "num_robots": 1,
            "sensor_noise": "false",
            "use_rviz": "true",
            "random_seed": 42
          }
        },
        {
          "name": "Scenario 4 - Two Robots",
          "description": "Two robots working together. Tests multi-robot coordination.",
          "parameters": {
            "num_robots": 2,
            "sensor_noise": "false",
            "use_rviz": "true"
          }
        },
        {
          "name": "Scenario 5 - Full Challenge",
          "description": "Single robot, noise enabled, headless for performance testing.",
          "parameters": {
            "num_robots": 1,
            "sensor_noise": "true",
            "use_rviz": "false",
            "headless": "false"
          }
        }
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}