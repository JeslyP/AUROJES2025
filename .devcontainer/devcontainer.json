// Use this devcontainer.json to develop within a standard Docker environment,
// with VNC providing the GUI support.
// It uses the prebuilt image from the GitHub Container Registry,
// so does not require a Dockerfile.
{
    "name": "auro-vnc",
    "image": "ghcr.io/uoy-robostar/ros2-tb3/auro-dev:latest",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind"
    ],
    "remoteUser": "ubuntu",
    "portsAttributes": {
        "6080": {
            "label": "Desktop"
        }
    },
    "forwardPorts": [6080],
    "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh",
    "postCreateCommand": "source /opt/ros/humble/setup.bash",
    "remoteEnv": {
        "USERNAME": "${localEnv:USERNAME}",
        "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}"
    },
    "containerEnv": {
        "VNC_RESOLUTION": "1280x720x24"
    },
    "customizations": {
        "auro": {
            "scenarios": [
                {
                    "name": "Scenario 1 - Single Robot Basic",
                    "description": "Single robot, no noise, standard configuration. Tests basic functionality.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "use_nav2": "true"
                    }
                },
                {
                    "name": "Scenario 2 - Single Robot with Noise",
                    "description": "Single robot with sensor noise enabled. Tests robustness.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "true",
                        "use_rviz": "true",
                        "use_nav2": "true"
                    }
                },
                {
                    "name": "Scenario 3 - Different Seed",
                    "description": "Single robot with different barrel distribution.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "use_nav2": "true",
                        "random_seed": "42"
                    }
                },
                {
                    "name": "Scenario 4 - Two Robots",
                    "description": "Two robots working in parallel.",
                    "parameters": {
                        "num_robots": 2,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "use_nav2": "true"
                    }
                },
                {
                    "name": "Scenario 5 - Performance Test",
                    "description": "Single robot, noise enabled, no RViz for faster execution.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "true",
                        "use_rviz": "false",
                        "use_nav2": "true",
                        "headless": "false"
                    }
                }
            ]
        },
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    }
}