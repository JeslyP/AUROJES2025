{
    "name": "AURO 2025 Coursework",
    "image": "ghcr.io/uoyauro/auro-vnc:humble",
    "customizations": {
        "auro": {
            "scenarios": [
                {
                    "name": "Scenario 1 - Single Robot Basic",
                    "description": "Single robot, no noise, standard barrel distribution. Tests basic functionality.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "num_barrels": 6,
                        "red_barrel_ratio": 0.5
                    }
                },
                {
                    "name": "Scenario 2 - Single Robot with Noise",
                    "description": "Single robot with sensor noise enabled. Tests robustness to sensor uncertainty.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "true",
                        "use_rviz": "true",
                        "num_barrels": 6,
                        "red_barrel_ratio": 0.5
                    }
                },
                {
                    "name": "Scenario 3 - High Contamination",
                    "description": "Single robot, mostly red barrels. Tests decontamination strategy.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "num_barrels": 8,
                        "red_barrel_ratio": 0.75
                    }
                },
                {
                    "name": "Scenario 4 - Many Barrels",
                    "description": "Single robot with many barrels. Tests search and collection efficiency.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "false",
                        "use_rviz": "true",
                        "num_barrels": 12,
                        "red_barrel_ratio": 0.5
                    }
                },
                {
                    "name": "Scenario 5 - Full Challenge",
                    "description": "Single robot, noise enabled, many barrels. Full challenge scenario.",
                    "parameters": {
                        "num_robots": 1,
                        "sensor_noise": "true",
                        "use_rviz": "false",
                        "num_barrels": 10,
                        "red_barrel_ratio": 0.6
                    }
                }
            ]
        },
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "forwardPorts": [6080],
    "postCreateCommand": "source /opt/ros/humble/setup.bash"
}