// Use this devcontainer.json to develop within a standard Docker environment,
// with VNC providing the GUI support.
// It uses the prebuilt image from the GitHub Container Registry,
// so does not require a Dockerfile.
{
  "name": "auro-vnc",
  "image": "ghcr.io/uoy-robostar/ros2-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      }
  },
  "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh",
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}"
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x720x24"
  },
  "customizations": {
    "auro": {
      "scenarios" : [
            {
                "name": "Scenario 1 - Baseline",
                "description": "Single robot, no obstacles, no noise. Validates basic collection.",
                "parameters": {
                    "use_rviz": "true",
                    "num_robots": 1,
                    "sensor_noise": "false",
                    "obstacles": "false"
                }
            },
            {
                "name": "Scenario 2 - Multi-Robot",
                "description": "Two robots. Validates multi-agent coordination.",
                "parameters": {
                    "use_rviz": "true",
                    "num_robots": 2,
                    "sensor_noise": "false",
                    "obstacles": "false"
                }
            },
            {
                "name": "Scenario 3 - Obstacles",
                "description": "Single robot with obstacles. Validates collision avoidance.",
                "parameters": {
                    "use_rviz": "true",
                    "num_robots": 1,
                    "sensor_noise": "false",
                    "obstacles": "true"
                }
            },
            {
                "name": "Scenario 4 - High Noise",
                "description": "Single robot with sensor noise. Validates robustness of visual servoing.",
                "parameters": {
                    "use_rviz": "true",
                    "num_robots": 1,
                    "sensor_noise": "true",
                    "obstacles": "false"
                }
            },
            {
                "name": "Scenario 5 - Stress Test",
                "description": "Two robots, obstacles, and noise. Full system validation.",
                "parameters": {
                    "use_rviz": "true",
                    "num_robots": 2,
                    "sensor_noise": "true",
                    "obstacles": "true"
                }
            }
      ]
    }
  }
}