{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon build",
            "type": "shell",
            "command": "colcon build --symlink-install",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Build ROS2 workspace with colcon"
        },
        {
            "label": "colcon build and source",
            "type": "shell",
            "command": "colcon build --symlink-install && source install/setup.bash",
            "group": "build",
            "problemMatcher": [],
            "detail": "Build and source ROS2 workspace"
        },
        {
            "label": "source workspace",
            "type": "shell",
            "command": "source install/setup.bash",
            "problemMatcher": [],
            "detail": "Source the ROS2 workspace"
        },
        {
            "label": "clean build",
            "type": "shell",
            "command": "rm -rf build install log && colcon build --symlink-install",
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean and rebuild workspace"
        },
        {
            "label": "launch simulation",
            "type": "shell",
            "command": "source install/setup.bash && ros2 launch solution solution_launch.py",
            "group": "test",
            "problemMatcher": [],
            "detail": "Launch the AURO simulation"
        }
    ]
}
